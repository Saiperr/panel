# Copia este fichero a .env y rellénalo. NO subas el .env real.
# Genera claves con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto
# Código que se pide una sola vez para crear el primer usuario en /configurar
SETUP_CODE=cambia-esto
# 1 si se sirve por HTTPS (detrás de un proxy); 0 solo para probar en local por http
COOKIE_SECURE=1
PORT=8085
